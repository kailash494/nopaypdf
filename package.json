{
  "name": "nopaypdf",
  "version": "1.0.0",
  "description": "100% Free browser-based PDF tools with zero subscriptions, sign-ups, or server uploads",
  "private": true,
  "scripts": {
    "build:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/tailwind.min.css --minify",
    "watch:css": "tailwindcss -i assets/css/tailwind.input.css -o assets/css/tailwind.min.css --watch"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.5",
    "tailwindcss": "^4.3.5"
  }
}
